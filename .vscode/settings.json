  "dbtLineage.manifestPath": "bai-tap-kimball-data-vault/lab/target/manifest.json",
  "dbtLineage.enableLiveParser": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/bai-tap-kimball-data-vault/.venv/bin/python",
